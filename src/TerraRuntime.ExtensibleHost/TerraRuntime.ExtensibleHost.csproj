<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>TerraRuntime.ExtensibleHost</RootNamespace>
    <AssemblyName>TerraRuntime.Extensible.Server</AssemblyName>
    <StartupObject>TerraRuntime.ExtensibleHost.Program</StartupObject>

    <!-- This host deliberately supports dynamic managed DLL loading. Keep AOT-only rules in the core graph. -->
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Production CoreCLR baseline for the long-running extensible server profile. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- Keep the CoreCLR deployment clean without sacrificing external managed plugin loading. -->
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(RuntimeIdentifier)' != ''">true</IncludeNativeLibrariesForSelfExtract>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>

    <ExtensibleDeploymentExecutableName Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))">$(AssemblyName).exe</ExtensibleDeploymentExecutableName>
    <ExtensibleDeploymentExecutableName Condition="'$(ExtensibleDeploymentExecutableName)' == ''">$(AssemblyName)</ExtensibleDeploymentExecutableName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../TerraRuntime.Extensibility/TerraRuntime.Extensibility.csproj" />
  </ItemGroup>

  <Target Name="PrepareExtensibleDeployment"
          AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' != '' and '$(PublishSingleFile)' == 'true'">
    <PropertyGroup>
      <ExtensibleDeploymentExecutable>$([System.IO.Path]::Combine('$(PublishDir)', '$(ExtensibleDeploymentExecutableName)'))</ExtensibleDeploymentExecutable>
    </PropertyGroup>

    <Error Condition="!Exists('$(ExtensibleDeploymentExecutable)')"
           Text="CoreCLR single-file publish completed without expected executable '$(ExtensibleDeploymentExecutable)'." />

    <ItemGroup>
      <ExtensibleDeploymentDebugSymbols Include="$(PublishDir)**/*.pdb;$(PublishDir)**/*.dbg" />
    </ItemGroup>

    <Delete Files="@(ExtensibleDeploymentDebugSymbols)" />
    <MakeDir Directories="$(PublishDir)runtime;$(PublishDir)HostModules;$(PublishDir)ServerPlugins;$(PublishDir)Worlds;$(PublishDir)config;$(PublishDir)data;$(PublishDir)logs" />

    <Message Importance="high"
             Text="Runnable TerraRuntime CoreCLR deployment: $(PublishDir)" />
  </Target>
</Project>
