<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>TerraRuntime.Server</RootNamespace>
    <AssemblyName>TerraRuntime.Server</AssemblyName>
    <StartupObject>TerraRuntime.Server.Program</StartupObject>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <PublishAot>true</PublishAot>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>

    <DeploymentExecutableName Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))">$(AssemblyName).exe</DeploymentExecutableName>
    <DeploymentExecutableName Condition="'$(DeploymentExecutableName)' == ''">$(AssemblyName)</DeploymentExecutableName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../TerraRuntime.Application/TerraRuntime.Application.csproj" />
  </ItemGroup>

  <Target Name="PrepareNativeDeployment"
          AfterTargets="Publish"
          Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''">
    <PropertyGroup>
      <DeploymentExecutable>$([System.IO.Path]::Combine('$(PublishDir)', '$(DeploymentExecutableName)'))</DeploymentExecutable>
    </PropertyGroup>

    <Error Condition="!Exists('$(DeploymentExecutable)')"
           Text="NativeAOT publish completed without expected executable '$(DeploymentExecutable)'." />

    <ItemGroup>
      <DeploymentDebugSymbols Include="$(PublishDir)**/*.pdb;$(PublishDir)**/*.dbg" />
    </ItemGroup>

    <Delete Files="@(DeploymentDebugSymbols)" />
    <MakeDir Directories="$(PublishDir)Worlds;$(PublishDir)config;$(PublishDir)data;$(PublishDir)logs" />

    <Message Importance="high"
             Text="Runnable TerraRuntime NativeAOT deployment: $(PublishDir)" />
  </Target>
</Project>
