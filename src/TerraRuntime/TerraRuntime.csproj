<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>TerraRuntime</RootNamespace>
    <AssemblyName>TerraRuntime.Server</AssemblyName>
    <StartupObject>TerraRuntime.StartupProgram</StartupObject>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <PublishAot>true</PublishAot>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>

    <DeploymentExecutableName Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))">$(AssemblyName).exe</DeploymentExecutableName>
    <DeploymentExecutableName Condition="'$(DeploymentExecutableName)' == ''">$(AssemblyName)</DeploymentExecutableName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TerraRuntime.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Terminal.Gui" Version="2.4.17" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../TerraRuntime.Contracts/TerraRuntime.Contracts.csproj" />
    <ProjectReference Include="../TerraRuntime.Core/TerraRuntime.Core.csproj" />
    <ProjectReference Include="../TerraRuntime.Gameplay/TerraRuntime.Gameplay.csproj" />
    <ProjectReference Include="../TerraRuntime.HostContracts/TerraRuntime.HostContracts.csproj" />
    <ProjectReference Include="../TerraRuntime.Network/TerraRuntime.Network.csproj" />
    <ProjectReference Include="../TerraRuntime.Protocol/TerraRuntime.Protocol.csproj" />
    <ProjectReference Include="../TerraRuntime.Protocol.Multiplicity/TerraRuntime.Protocol.Multiplicity.csproj" />
    <ProjectReference Include="../TerraRuntime.World/TerraRuntime.World.csproj" />
  </ItemGroup>

  <Target Name="PrepareNativeDeployment"
          AfterTargets="Publish"
          Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''">
    <PropertyGroup>
      <DeploymentExecutable>$([System.IO.Path]::Combine('$(PublishDir)', '$(DeploymentExecutableName)'))</DeploymentExecutable>
    </PropertyGroup>

    <Error Condition="!Exists('$(DeploymentExecutable)')"
           Text="NativeAOT publish completed without expected executable '$(DeploymentExecutable)'." />

    <ItemGroup>
      <DeploymentDebugSymbols Include="$(PublishDir)**/*.pdb;$(PublishDir)**/*.dbg" />
    </ItemGroup>

    <Delete Files="@(DeploymentDebugSymbols)" />
    <MakeDir Directories="$(PublishDir)Worlds;$(PublishDir)config;$(PublishDir)data;$(PublishDir)logs" />

    <Message Importance="high"
             Text="Runnable TerraRuntime NativeAOT deployment: $(PublishDir)" />
  </Target>
</Project>
