<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>TerraRuntime</RootNamespace>
    <AssemblyName>TerraRuntime.Server</AssemblyName>
    <StartupObject>TerraRuntime.StartupProgram</StartupObject>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <PublishAot>true</PublishAot>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <ServerGarbageCollection>true</ServerGarbageCollection>

    <CleanDeploymentRoot Condition="'$(CleanDeploymentRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../artifacts/deploy/$(RuntimeIdentifier)'))</CleanDeploymentRoot>
    <CleanDeploymentExecutableName Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))">$(AssemblyName).exe</CleanDeploymentExecutableName>
    <CleanDeploymentExecutableName Condition="'$(CleanDeploymentExecutableName)' == ''">$(AssemblyName)</CleanDeploymentExecutableName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TerraRuntime.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Terminal.Gui" Version="2.4.17" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../TerraRuntime.Contracts/TerraRuntime.Contracts.csproj" />
    <ProjectReference Include="../TerraRuntime.Core/TerraRuntime.Core.csproj" />
    <ProjectReference Include="../TerraRuntime.Network/TerraRuntime.Network.csproj" />
    <ProjectReference Include="../TerraRuntime.Protocol/TerraRuntime.Protocol.csproj" />
    <ProjectReference Include="../TerraRuntime.Protocol.Multiplicity/TerraRuntime.Protocol.Multiplicity.csproj" />
    <ProjectReference Include="../TerraRuntime.World/TerraRuntime.World.csproj" />
  </ItemGroup>

  <Target Name="CreateCleanNativeDeployment"
          AfterTargets="Publish"
          Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''">
    <PropertyGroup>
      <CleanDeploymentSourceExecutable>$([System.IO.Path]::Combine('$(PublishDir)', '$(CleanDeploymentExecutableName)'))</CleanDeploymentSourceExecutable>
    </PropertyGroup>

    <Error Condition="!Exists('$(CleanDeploymentSourceExecutable)')"
           Text="NativeAOT publish completed without expected executable '$(CleanDeploymentSourceExecutable)'." />

    <RemoveDir Directories="$(CleanDeploymentRoot)" />
    <MakeDir Directories="$(CleanDeploymentRoot);$(CleanDeploymentRoot)/Worlds;$(CleanDeploymentRoot)/config;$(CleanDeploymentRoot)/data;$(CleanDeploymentRoot)/logs" />
    <Copy SourceFiles="$(CleanDeploymentSourceExecutable)"
          DestinationFolder="$(CleanDeploymentRoot)" />

    <Message Importance="high"
             Text="Clean TerraRuntime deployment: $(CleanDeploymentRoot)" />
  </Target>
</Project>
